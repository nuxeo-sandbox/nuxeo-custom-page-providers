<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nuxeo.labs.custom.page.providers</groupId>
        <artifactId>nuxeo-custom-page-providers-parent</artifactId>
        <version>2025.4.0-SNAPSHOT</version>
    </parent>
    <artifactId>nuxeo-custom-page-providers-opensearch2</artifactId>
    <name>Nuxeo Custom PageProviders OpenSearch 2 adapter</name>
    <description>Vector search engine for the opensearch2 search client. Only loaded when that client is deployed.</description>

    <dependencies>
        <dependency>
            <groupId>org.nuxeo.labs.custom.page.providers</groupId>
            <artifactId>nuxeo-custom-page-providers-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.runtime</groupId>
            <artifactId>nuxeo-runtime</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.core</groupId>
            <artifactId>nuxeo-core-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.core</groupId>
            <artifactId>nuxeo-core-query</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.ecm.core</groupId>
            <artifactId>nuxeo-core-search</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- OpenSearch 2 only (nuxeo-opensearch2 addon, which brings the opensearch-java client):
             never add an OpenSearch 1 dependency to this module -->
        <dependency>
            <groupId>org.nuxeo.opensearch2</groupId>
            <artifactId>nuxeo-runtime-opensearch2</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.nuxeo.opensearch2</groupId>
            <artifactId>nuxeo-search-client-opensearch2</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
